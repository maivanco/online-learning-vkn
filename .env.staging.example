APP_NAME="Online Learning (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# Change this to your staging domain or IP:PORT (e.g. http://your-staging-domain.com or http://your-ip:8090)
APP_URL=https://vkn.mike-tran.dev
SANCTUM_STATEFUL_DOMAINS=vkn.mike-tran.dev

# Port configuration for Staging (Port 80 is occupied on the host)
APP_PORT=8090
FORWARD_DB_PORT=3307

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
APP_SERVICE=laravel.app

# Database configuration (inside docker network, connects to container named mysql on port 3306)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=online_learning_staging
DB_USERNAME=sail
DB_PASSWORD=staging_secure_password_here

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SAIL_XDEBUG_MODE=off
